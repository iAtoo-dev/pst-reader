# PST Archive Server — configuration
# Copy to .env and adjust values

# Directory containing your .pst files
PST_DIR=/data/pst-archives

# Password for Basic Auth (leave empty to disable auth)
PST_PASSWORD=changeme

# HTTP port
PORT=3000

# Path to built frontend (after: cd pst-viewer && npm run build)
# FRONTEND=./pst-viewer/dist/index.html
